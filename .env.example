# PUBLIC: compiled into the frontend. Never put a key here.
VITE_API_URL=
# Backend only. HTTPS origin allowed to call this service.
ALLOWED_ORIGINS=https://harleyzinn.github.io,http://127.0.0.1:5173,http://localhost:5173
HOST=127.0.0.1
PORT=8787
# Paths to trusted executables installed by the server administrator.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Optional: isolated temporary directory (default: OS temp).
# TEMP_ROOT=
# No file/media/ZIP byte quotas. Use a disk-backed directory with sufficient space.
# Kill workers only after no observed byte/file changes (default: 10 minutes).
WORKER_IDLE_MS=600000
# Inactive outbound file responses (default: 5 minutes), not total duration.
STREAM_IDLE_MS=300000
# Optional direct HTTPS deployment using compose.caddy.yaml, on your own server:
# API_DOMAIN=api.your-existing-domain.com
