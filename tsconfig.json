{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "resolveJsonModule": true, "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "types": ["vite/client", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "backend", "test", "scripts", "desktop", "vite.config.ts"]
}
