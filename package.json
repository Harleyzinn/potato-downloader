{
  "name": "potato-dumper",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "backend": "tsx --env-file-if-exists=.env backend/server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "engine:update": "tsx scripts/update-engine.ts"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "ffmpeg-static": "5.3.0",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.5"
  }
}
